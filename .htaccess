# Enable URL rewriting
RewriteEngine On

# Set the base
RewriteBase /

# Do not apply rules to existing directories and files
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f

# Redirect /home to index.html
RewriteRule ^home$ index.html [L]

# Section-specific routes that link to anchors in index.html
RewriteRule ^expertise$ index.html#expertise [L,NE]
RewriteRule ^services$ index.html#services [L,NE]
RewriteRule ^projects$ index.html#projects [L,NE]
RewriteRule ^about$ index.html#about [L,NE]
RewriteRule ^contact$ index.html#contact [L,NE]

# Publications page
RewriteRule ^publications$ publications.html [L]

# Remove trailing slashes if present
RewriteRule ^(.+)/$ $1 [L,R=301]

# Prevent directory browsing
Options -Indexes

# Set default character set
AddDefaultCharset UTF-8

# Set default document
DirectoryIndex index.html

# Enable keep-alive connections
<IfModule mod_headers.c>
    Header set Connection keep-alive
</IfModule>

# Set cache control for better performance
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/x-javascript "access plus 1 month"
    ExpiresDefault "access plus 2 days"
</IfModule> 